DATABASE_URL="file:./dev.db"

# 三方回调鉴权密钥（HMAC-SHA256 签名）。未配置时 /api/integrations/* 默认拒绝所有回调（fail-closed）。
# 生产环境务必替换为高强度随机值，并与外部系统约定同一密钥。
INTEGRATION_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# 智能查询（DeepSeek，可选）。未配置时 NL 查询接口返回明确提示，不影响其他功能。
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Text-to-SQL（受控只读，可选）。off=关闭；readonly=仅 SQL；hybrid=推荐（白名单失败时回退 SQL）
NL_SQL_MODE="hybrid"
